# Static site with one prerendered HTML file per page (npm run build -> scripts/prerender.mjs):
#   /            -> index.html
#   /o-nas       -> o-nas.html
#   /en/about    -> en/about.html
# Every page has one URL (no trailing slash, no .html). Unknown paths get 404.html with a real
# 404 status. /api/ (contact.php) is left alone.

Options -MultiViews
DirectorySlash Off
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # one host over HTTPS: www -> danau.sk; http -> https where a proxy reports the scheme
  RewriteCond %{HTTP_HOST} ^www\.danau\.sk$ [NC]
  RewriteRule ^ https://danau.sk%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  RewriteRule ^api/ - [L]

  # one URL per page: /index.html -> /, /o-nas.html -> /o-nas, /o-nas/ -> /o-nas
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ https://%{HTTP_HOST}/ [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L]
  RewriteRule ^(.+)/$ https://%{HTTP_HOST}/$1 [R=301,L]

  # the services overview lives on the home page
  RewriteRule ^sluzby$ https://%{HTTP_HOST}/#sluzby [R=301,NE,L]
  RewriteRule ^en/services$ https://%{HTTP_HOST}/en#services [R=301,NE,L]

  # the home page and real files (assets, images, sitemap.xml, robots.txt, llms.txt)
  RewriteRule ^$ index.html [L]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # prerendered pages
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]

  # anything else does not exist
  RewriteRule ^ - [R=404,L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType text/plain .txt
  AddCharset utf-8 .html .txt .xml .webmanifest
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # hashed build assets never change; pages and their metadata must always be fresh
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/xml "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
